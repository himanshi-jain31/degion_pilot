# DesignPilot settings. Copy this file to a new file named .env.local, then edit .env.local.
# (.env.local is never saved to GitHub, so each person makes their own.)

# To try the app WITHOUT a key (sample results only): leave the key empty and keep DEMO_MODE=on.
# To use the real AI: paste your key after the = sign (no spaces, no quotes). Demo mode then switches off by itself.
ANTHROPIC_API_KEY=
DEMO_MODE=on

# Optional: only needed for "Add a Figma file".
FIGMA_ACCESS_TOKEN=
