        "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Wireframe</title><style>*{box-sizing:border-box}body{margin:0;font-family:system-ui,sans-serif;background:#f2f2f2;color:#333;line-height:1.4}\n.menu{position:sticky;top:0;z-index:5;display:flex;gap:10px;align-items:center;padding:8px 12px;background:#333;color:#f2f2f2;font-size:14px}\n.menu select{flex:1;min-width:0;padding:6px;border-radius:6px;border:1px solid #888;background:#f2f2f2;color:#333}\n.screen{display:none;max-width:1000px;margin:0 auto;padding:16px}.screen.active{display:block}\n.bar{padding:12px 14px;background:#d9d9d9;border:1px solid #aaa;border-radius:8px;font-weight:600;margin-bottom:12px}\n.title{font-size:22px;font-weight:700;margin:8px 0}.sub{font-size:16px;font-weight:600;margin:8px 0}.muted{color:#777;font-size:14px}\n.box,.card,.item,.empty{background:#fff;border:1px solid #bbb;border-radius:8px;padding:12px;margin:8px 0}\n.card[data-go],.item[data-go],[data-go]{cursor:pointer}\n.row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}.row>*{flex:1 1 200px}.col{display:flex;flex-direction:column;gap:8px}\n.btn{display:inline-block;padding:10px 16px;border:1px solid #666;border-radius:8px;background:#e6e6e6;color:#333;font:inherit;text-decoration:none;cursor:pointer}\n.btn.primary{background:#333;color:#f2f2f2;border-color:#333}.btn:hover{filter:brightness(.95)}\n.input{display:block;width:100%;padding:10px;border:1px solid #999;border-radius:6px;background:#fff;font:inherit;margin:4px 0 10px}\n.label{display:block;font-size:14px;font-weight:600}.list{display:flex;flex-direction:column}.tabs{display:flex;gap:6px;margin:8px 0}\n.tab{padding:8px 14px;border:1px solid #aaa;border-radius:8px 8px 0 0;background:#e6e6e6}\n.banner{padding:10px 12px;border:1px solid #999;border-radius:8px;background:#e0e0e0;margin:8px 0}.banner.error{background:#ddd;border:2px solid #555}\n.img{min-height:90px;background:repeating-linear-gradient(45deg,#e4e4e4,#e4e4e4 10px,#d6d6d6 10px,#d6d6d6 20px);border:1px solid #bbb;border-radius:8px}\n.badge{display:inline-block;padding:2px 8px;border-radius:99px;background:#ccc;font-size:12px}.empty{text-align:center;color:#666;padding:28px}\na{color:#333}</style></head><body>\n<div class=\"menu\"><strong>Wireframe</strong><select id=\"jump\" aria-label=\"Jump to a screen\"><option value=\"home\">Home</option><option value=\"new-request\">New request</option><option value=\"request-list\">My requests</option><option value=\"empty-list\">No requests yet</option><option value=\"error\">Something went wrong</option><option value=\"no-access\">No permission</option></select></div>\n<section class=\"screen\" id=\"screen-home\"><div class=\"bar\">DEMO · Home</div><p class=\"title\">Home</p><p class=\"muted\">See your requests and start a new one</p><div class=\"card\" data-go=\"request-list\"><p class=\"sub\">DEMO: Days left</p><p>12 days</p></div><div class=\"row\"><button class=\"btn primary\" data-go=\"new-request\">New request</button><button class=\"btn\" data-go=\"request-list\">My requests</button><button class=\"btn\" data-go=\"empty-list\">See empty state</button><button class=\"btn\" data-go=\"error\">See error state</button><button class=\"btn\" data-go=\"no-access\">See no-permission state</button></div></section>\n<section class=\"screen\" id=\"screen-new-request\"><div class=\"bar\">DEMO · New request</div><p class=\"title\">New request</p><p class=\"muted\">Pick dates and send a request</p><form data-go=\"request-list\"><label class=\"label\">From</label><input class=\"input\" value=\"12 Dec\"><label class=\"label\">To</label><input class=\"input\" value=\"14 Dec\"><button class=\"btn primary\">Send request</button></form><div class=\"row\"><button class=\"btn\" data-go=\"error\">Pretend sending fails</button><button class=\"btn\" data-go=\"home\">Cancel</button></div></section>\n<section class=\"screen\" id=\"screen-request-list\"><div class=\"bar\">DEMO · My requests</div><p class=\"title\">My requests</p><p class=\"muted\">See every request and its answer</p><div class=\"list\"><div class=\"item\" data-go=\"home\">12–14 Dec · <span class=\"badge\">Waiting</span></div><div class=\"item\" data-go=\"home\">3 Nov · <span class=\"badge\">Approved</span></div></div><button class=\"btn\" data-go=\"home\">Back to Home</button></section>\n<section class=\"screen\" id=\"screen-empty-list\"><div class=\"bar\">DEMO · No requests yet</div><p class=\"title\">No requests yet</p><p class=\"muted\">Shown when there are no requests</p><div class=\"empty\">DEMO: nothing to show here yet.</div><button class=\"btn primary\" data-go=\"home\">Back to Home</button></section>\n<section class=\"screen\" id=\"screen-error\"><div class=\"bar\">DEMO · Something went wrong</div><p class=\"title\">Something went wrong</p><p class=\"muted\">Shown when sending fails</p><div class=\"banner error\">DEMO: We could not send your request. Nothing was lost.</div><button class=\"btn primary\" data-go=\"new-request\">Try again</button> <button class=\"btn\" data-go=\"home\">Back to Home</button></section>\n<section class=\"screen\" id=\"screen-no-access\"><div class=\"bar\">DEMO · No permission</div><p class=\"title\">No permission</p><p class=\"muted\">Shown when someone may not open a page</p><div class=\"empty\">DEMO: nothing to show here yet.</div><button class=\"btn primary\" data-go=\"home\">Back to Home</button></section>\n<script>(function(){var sel=document.getElementById('jump');var screens=[].slice.call(document.querySelectorAll('.screen'));\nfunction show(id){var f=false;screens.forEach(function(s){var on=s.id==='screen-'+id;if(on)f=true;s.classList.toggle('active',on)});\nif(!f)return;sel.value=id;window.scrollTo(0,0);try{history.replaceState(null,'','#'+id)}catch(e){}}\ndocument.addEventListener('click',function(e){var t=e.target.closest('[data-go]');if(t&&t.tagName!=='FORM'){e.preventDefault();show(t.getAttribute('data-go'))}});\ndocument.addEventListener('submit',function(e){e.preventDefault();var g=e.target.getAttribute('data-go');if(g)show(g)});\nsel.addEventListener('change',function(){show(sel.value)});\nvar start=(location.hash||'').slice(1);show(screens.some(function(s){return s.id==='screen-'+start})?start:screens[0].id.replace('screen-',''));})();</script></body></html>",
